# Managed by Ansible - see `mise_global_tools` in default.config.yml and
# tasks/mise.yml. Local edits are overwritten on the next playbook run.
#
# Machine-local overrides belong in ~/.config/mise/conf.d/, which Ansible
# does not touch.

[settings]
# Let per-project .ruby-version files pick the ruby version.
idiomatic_version_file_enable_tools = ["ruby"]

[settings.ruby]
# Precompiled binaries only - never fall back to a ruby-build source compile.
compile = false

[tools]
{# A tool's value is a version string, or a mapping of tool options rendered as
   a TOML inline table. JSON strings and string arrays are valid TOML values. #}
{% for name, value in mise_global_tools.items() %}
{% if name is search('[^A-Za-z0-9_-]') %}"{{ name }}"{% else %}{{ name }}{% endif %} = {% if value is mapping %}{ {% for k, v in value.items() %}{{ k }} = {{ v | to_json }}{{ ", " if not loop.last }}{% endfor %} }{% else %}{{ value | to_json }}{% endif %}

{% endfor %}
